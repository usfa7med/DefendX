{
  "name": "log-analyzer",
  "version": "1.0.0",
  "description": "Mini WAF + SIEM + IDS",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
